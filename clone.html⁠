<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kho Clone Hệ Thống - Tool Liên Quân</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --bg-body: #0f172a;
            --bg-card: #1e293b;
            --bg-input: #0f172a;
            --text-main: #f8fafc;
            --text-sub: #94a3b8;
            --border-color: #334155;
            --primary-color: #8b5cf6;
            --primary-gradient: linear-gradient(135deg, #a855f7, #6366f1);
            --accent-green: #10b981;
        }
        [data-theme="light"] {
            --bg-body: #f1f5f9;
            --bg-card: #ffffff;
            --bg-input: #f8fafc;
            --text-main: #0f172a;
            --text-sub: #64748b;
            --border-color: #e2e8f0;
        }
        * { box-sizing: border-box; transition: background 0.3s, color 0.3s; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            margin: 0; padding: 12px;
            display: flex; justify-content: center;
        }
        .container { width: 100%; max-width: 480px; }
        
        .top-nav {
            display: flex; justify-content: space-between; align-items: center;
            background: var(--bg-card); padding: 10px 16px; border-radius: 12px;
            border: 1px solid var(--border-color); margin-bottom: 12px;
        }
        .back-home { color: #a855f7; text-decoration: none; font-weight: bold; font-size: 13px; display: flex; align-items: center; gap: 6px; }

        .main-card {
            background: var(--bg-card); border: 1px solid var(--border-color);
            border-radius: 16px; padding: 16px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
        }
        .card-title { font-size: 15px; font-weight: bold; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; color: #a855f7; }

        .clone-table-container {
            max-height: 350px;
            overflow-y: auto;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            margin-bottom: 12px;
        }
        .clone-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 12px;
            border-bottom: 1px solid var(--border-color);
            font-size: 12px;
        }
        .clone-item:last-child { border-bottom: none; }
        .badge-ready { background: rgba(16, 185, 129, 0.15); color: var(--accent-green); padding: 2px 8px; border-radius: 6px; font-weight: bold; font-size: 10px; }
        
        .btn-action {
            background: var(--primary-gradient);
            color: white; border: none; padding: 6px 12px;
            border-radius: 6px; font-size: 11px; font-weight: bold; cursor: pointer;
        }
        .stats-box {
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            padding: 10px; border-radius: 8px;
            font-size: 12px; text-align: center; margin-bottom: 12px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="top-nav">
        <a href="tool.html" class="back-home"><i class="fa-solid fa-arrow-left"></i> Quay lại Tool chính</a>
        <div style="font-size: 12px; font-weight: bold; color: var(--accent-green);">Trực tuyến 24/7</div>
    </div>

    <div class="main-card">
        <div class="card-title"><i class="fa-solid fa-database"></i> Kho Chứa Acc Clone Hệ Thống</div>
        
        <div class="stats-box">
            Tổng số lượng acc sẵn sàng trong kho: <strong style="color: #a855f7; font-size: 14px;">9,169 Acc</strong>
        </div>

        <div class="clone-table-container" id="cloneList">
            <!-- Danh sách acc clone mẫu -->
            <div class="clone-item">
                <div>
                    <div style="font-weight: bold;">Clone_AOV_019283</div>
                    <div style="color: var(--text-sub); font-size: 10px;">Đã sẵn sàng kéo điểm</div>
                </div>
                <div><span class="badge-ready">Sẵn sàng</span></div>
            </div>
            <div class="clone-item">
                <div>
                    <div style="font-weight: bold;">Clone_AOV_019284</div>
                    <div style="color: var(--text-sub); font-size: 10px;">Đã sẵn sàng kéo điểm</div>
                </div>
                <div><span class="badge-ready">Sẵn sàng</span></div>
            </div>
            <div class="clone-item">
                <div>
                    <div style="font-weight: bold;">Clone_AOV_019285</div>
                    <div style="color: var(--text-sub); font-size: 10px;">Đã sẵn sàng kéo điểm</div>
                </div>
                <div><span class="badge-ready">Sẵn sàng</span></div>
            </div>
            <div class="clone-item">
                <div>
                    <div style="font-weight: bold;">Clone_AOV_019286</div>
                    <div style="color: var(--text-sub); font-size: 10px;">Đã sẵn sàng kéo điểm</div>
                </div>
                <div><span class="badge-ready">Sẵn sàng</span></div>
            </div>
            <div class="clone-item">
                <div>
                    <div style="font-weight: bold;">Clone_AOV_019287</div>
                    <div style="color: var(--text-sub); font-size: 10px;">Đã sẵn sàng kéo điểm</div>
                </div>
                <div><span class="badge-ready">Sẵn sàng</span></div>
            </div>
        </div>

        <button class="btn-action" style="width: 100%; padding: 10px;" onclick="alert('Đã làm mới danh sách kho clone hệ thống!')">
            <i class="fa-solid fa-rotate"></i> Cập Nhật Lại Kho Clone
        </button>
    </div>
</div>

</body>
</html>
